---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from './CTA.astro';
const { entry, section, label } = Astro.props;
const breadcrumbs = [
  { name: 'Početna', url: '/' },
  { name: section, url: `/${section === 'SEO' ? 'seo' : section === 'Web' ? 'web-stranice' : 'ai-rjesenja'}/` },
  { name: entry.data.title, url: Astro.url.pathname },
];
const serviceLabel = label ?? `BrandistiQ · ${section}`;
---
<BaseLayout title={`${entry.data.title} | BrandistiQ`} description={entry.data.description} breadcrumbs={breadcrumbs}>
  <article class="article-page">
    <div class="container article-wrap">
      <div class="eyebrow">{serviceLabel}</div>
      <h1>{entry.data.title}</h1>
      <p class="article-lead">{entry.data.description}</p>
      <div class="article-body"><slot /></div>
      <CTA title="Želite razgovarati o projektu?" text="Pošaljite nam osnovne informacije. Zajedno možemo definirati prvi konkretan korak." />
    </div>
  </article>
</BaseLayout>
